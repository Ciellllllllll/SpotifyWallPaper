[Unit]
Description=Spotify Wallpaper deletion-ledger reconciliation
After=postgresql@17-swp.service
Requires=postgresql@17-swp.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/spotify-wallpaper/reconcile.sh
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/spotify-wallpaper /run/postgresql
RestrictAddressFamilies=AF_UNIX
