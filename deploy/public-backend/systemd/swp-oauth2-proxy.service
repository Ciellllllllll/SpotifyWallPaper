[Unit]
Description=Spotify Wallpaper GitHub admin proxy
After=network-online.target systemd-tmpfiles-setup.service swp-public-backend.service
Wants=network-online.target
Requires=swp-public-backend.service
ConditionPathIsDirectory=/run/spotify-wallpaper/oauth

[Service]
Type=simple
User=oauth2-proxy
Group=swp-oauth
SupplementaryGroups=swp-admin
EnvironmentFile=/etc/spotify-wallpaper/oauth2-proxy.env
ExecStartPre=/usr/local/libexec/spotify-wallpaper/preflight.sh oauth2-proxy
ExecStartPre=/usr/local/bin/oauth2-proxy --config=/etc/spotify-wallpaper/oauth2-proxy.cfg --config-test
ExecStart=/usr/local/bin/oauth2-proxy --config=/etc/spotify-wallpaper/oauth2-proxy.cfg
Restart=on-failure
RestartSec=5s
UMask=0117

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/spotify-wallpaper/oauth
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
