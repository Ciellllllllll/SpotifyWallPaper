[Unit]
Description=Spotify Wallpaper policy-locked public backend
After=postgresql@17-swp.service
ConditionPathIsDirectory=/run/spotify-wallpaper/public
ConditionPathIsDirectory=/run/spotify-wallpaper/admin

[Service]
Type=simple
User=swp_backend
Group=swp_backend
SupplementaryGroups=swp-pg
EnvironmentFile=/etc/spotify-wallpaper/public-backend.env
WorkingDirectory=/opt/spotify-wallpaper/current/app/apps/public-backend
ExecStartPre=/usr/bin/test -r /opt/spotify-wallpaper/current/app/apps/public-backend/dist/src/index.js
ExecStartPre=/usr/local/libexec/spotify-wallpaper/preflight.sh node
ExecStartPre=/usr/bin/rm -f -- /run/spotify-wallpaper/public/public.sock /run/spotify-wallpaper/admin/admin.sock
ExecStart=/usr/bin/node dist/src/index.js
Restart=on-failure
RestartSec=5s
UMask=0117

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/opt/spotify-wallpaper/current
ReadWritePaths=/run/spotify-wallpaper/public /run/spotify-wallpaper/admin
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
