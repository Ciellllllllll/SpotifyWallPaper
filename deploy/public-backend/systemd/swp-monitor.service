[Unit]
Description=Spotify Wallpaper local readiness monitor
After=swp-public-backend.service postgresql@17-swp.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/spotify-wallpaper/monitor.sh all
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
