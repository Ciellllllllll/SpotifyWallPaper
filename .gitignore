# Dependency caches
/node_modules/
/apps/*/node_modules/
/packages/*/node_modules/

# Rust and application build output
/target/
/apps/configurator/src-tauri/target/
/apps/configurator/src-tauri/gen/
/apps/*/dist/
/apps/*/.vite/
/packages/*/dist/
/apps/spotify-auth/pages/
/apps/wallpaper/public/wasm/

# Local residue from the retired Cloudflare implementation; never release it.
/apps/cloudflare-worker/.wrangler/
/apps/cloudflare-worker/.wrangler.*.generated.json*
/apps/cloudflare-worker/dist-preview*/
/apps/cloudflare-worker/dist-production/
/apps/public-backend/.wrangler/
/apps/public-backend/.wrangler.*.generated.json*
/apps/public-backend/dist-preview*/
/apps/public-backend/dist-production/
/apps/public-backend/node-test/
/dist-preview/
/dist-production/

# Local environment and secret-bearing files
/**/.env
/**/.env.*
!/**/.env.example
/**/.dev.vars
/**/.dev.vars.*
!/**/.dev.vars.example
/**/.envrc
/**/.envrc.*
!/**/.envrc.example
/**/.direnv/

# Local evidence, archives, and agent/tool state
/artifacts/
/docs/phase-reports.zip
/.codex-*.log
/.codex/
/.codegraph/
/.superpowers/
/goal/
/.agents/
/.claude/
/CLAUDE.md
/.worktrees/
